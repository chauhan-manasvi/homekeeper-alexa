# The simulator's agent needs one model provider. The free options come first.
# The MCP server itself needs no model or key.

# Option 1 (free, no card): Groq. Get a key at https://console.groq.com/keys
# GROQ_API_KEY=

# Option 2 (free tier): Google Gemini. Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# Option 3 (free, offline): Ollama on your own machine. Run "ollama pull qwen2.5:3b"
# LLM_PROVIDER=ollama

# Option 4: Claude via the Claude API or Amazon Bedrock
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=bedrock
# AWS_REGION=us-east-1

# Optional overrides
# LLM_MODEL=openai/gpt-oss-120b
# LLM_BASE_URL=            # any OpenAI-compatible endpoint (used with groq/gemini/ollama)
# PORT=8787
# HTTPS_PORT=8443          # HTTPS for phones/other computers so the mic works; 0 turns it off
# HOMEKEEPER_HOUSEHOLD=demo-home
# HOMEKEEPER_TODAY=2026-10-22   # pin "today" for a repeatable demo
